# Optional. Copy to .env to override defaults: cp .env.example .env
# Passwords are NOT set here. They live in Docker secret files under secrets/
# (git-ignored). Create them with: ./scripts/init-secrets.sh

# PostgreSQL (applied only when the postgres_data volume is first created)
# POSTGRES_USER=app
# POSTGRES_DB=appdb

# Optional
# ENVIRONMENT=production
# APP_PORT=8000

# Host ports for local tools (compose.override.yaml only)
# POSTGRES_HOST_PORT=5432
# REDIS_HOST_PORT=6379
